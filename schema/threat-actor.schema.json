{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cyberthreat-intel/schema/threat-actor.schema.json",
  "title": "Threat Actor",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "aliases", "attribution", "digital_footprints", "source_ids", "last_updated"],
  "properties": {
    "id": {"type": "string", "pattern": "^TA-[0-9]{3,}$"},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "category": {"enum": ["state-sponsored", "hacktivist", "cybercriminal", "unknown"]},
    "claimed_affiliation": {"type": ["string", "null"]},
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "summary"],
      "properties": {
        "status": {"enum": ["officially-attributed", "widely-assessed", "claimed", "disputed", "unknown"]},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "description": {"type": "string"},
    "known_activity": {"type": "array", "items": {"type": "string"}},
    "digital_footprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "url", "association_status", "notes"],
        "properties": {
          "platform": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "association_status": {"enum": ["verified", "self-claimed", "reported", "unverified"]},
          "notes": {"type": "string"},
          "repositories": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "url", "language", "review_status"], "properties": {"name": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "language": {"type": ["string", "null"]}, "review_status": {"enum": ["not-reviewed", "metadata-reviewed", "code-reviewed"]}}}}
        }
      }
    },
    "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "last_updated": {"type": "string", "format": "date"}
  }
}
